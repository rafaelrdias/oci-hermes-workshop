[Unit]
Description=Hermes stand - Telegram gateway
After=network-online.target hermes-oci-bridge.service
Wants=network-online.target hermes-oci-bridge.service
ConditionPathExists=/var/lib/hermes/.hermes/telegram.ready
StartLimitIntervalSec=0

[Service]
User=hermes
Group=hermes
WorkingDirectory=/var/lib/hermes/workspace
Environment=HOME=/var/lib/hermes
Environment=HERMES_HOME=/var/lib/hermes/.hermes
Environment=PATH=/opt/hermes-stand/agent/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/bash -c 'exec /opt/hermes-stand/agent/.venv/bin/python -m hermes_cli.main gateway run'
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes
PrivateTmp=true

[Install]
WantedBy=multi-user.target
