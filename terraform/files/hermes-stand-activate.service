[Unit]
Description=Hermes OCI - automatic test and private Telegram pairing
After=network-online.target hermes-oci-bridge.service
Wants=network-online.target hermes-oci-bridge.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/opt/hermes-stand
ExecStart=/usr/bin/bash -c 'exec /opt/hermes-stand/agent/.venv/bin/python -u /opt/hermes-stand/activate.py'
Restart=on-failure
RestartSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
